# 環境変数の一覧。docker compose はプロジェクト直下の .env を自動で読む。
# 使う場合は `cp .env.example .env` してから編集する（.env はコミットしない）。
# docker を使わない場合は python manage.py がこのファイルを読まないため、シェルで export する。

# デバッグ有効化 (1/true/yes/on)。未設定は無効。manage.py 経由のときだけ既定で 1 になる。
# 本番(Vercel)では設定しないこと。
DJANGO_DEBUG=1

# Djangoの署名用シークレット。DJANGO_DEBUG 無効時は必須。50文字以上のランダム文字列にする。
# 生成: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# 許可するホスト名（カンマ区切り）。VERCEL 環境変数が設定されていると .vercel.app も自動で許可される。
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF を信頼するオリジン（スキーム付き・カンマ区切り）。例: https://example.com
CSRF_TRUSTED_ORIGINS=

# DB接続URL。未設定なら db.sqlite3 (SQLite)。本番は Neon のプール接続文字列（sslmode=require）を指定する。
# docker compose では db サービスへの接続で固定されるため、この値は使われない。
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# DJANGO_DEBUG 無効時のみ有効な設定。
# HTTPS へのリダイレクト(既定 1)。http でしか動かないローカルの docker などでは 0 にする。
SECURE_SSL_REDIRECT=0
# HSTS の秒数(既定 3600)。
# SECURE_HSTS_SECONDS=3600

# Vercel が自動で設定する。設定されていると ALLOWED_HOSTS に .vercel.app が追加される。手動設定は不要。
# VERCEL=1
